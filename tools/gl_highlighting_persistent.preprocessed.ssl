procedure check_filesystem_override begin
   variable fs_override := get_ini_setting("ddraw.ini|Misc|UseFileSystemOverride");
   if fs_override != 1 then begin
      debug_msg( "gl_highlighting" + ": " + "UseFileSystemOverride is disabled, enabling" + "\n") ;
      sfall_func2("set_ini_setting", "ddraw.ini|Misc|UseFileSystemOverride", 1) ;
      float_msg(dude_obj,  "gl_highlighting"  + ": filesystem override was disabled, some features failed to load. The setting is corrected. EXIT AND RE-LAUNCH THE GAME now.",  (-2) );
      return false;
   end
   return true;
end


