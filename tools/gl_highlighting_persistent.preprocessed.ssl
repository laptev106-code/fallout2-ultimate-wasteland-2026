procedure ClearAllOutlines begin
   variable obj;
   foreach obj in list_as_array( (1) ) begin
      if obj then  sfall_func2("set_outline", obj, 0) ;
   end
   foreach obj in list_as_array( (0) ) begin
      if obj then  sfall_func2("set_outline", obj, 0) ;
   end
   foreach obj in list_as_array( (2) ) begin
      if obj then  sfall_func2("set_outline", obj, 0) ;
   end

   sfall_func0("tile_refresh_display") ;
end

procedure ApplyOutlines begin
   variable obj, isCorpse, sid;


   foreach obj in list_as_array( (1) ) begin
      if (obj and obj !=  sfall_func0("outlined_object")  and not  ( sfall_func1("get_flags", obj) bwand FLAG_NOHIGHLIGHT) ) then begin
         if (obj_item_subtype(obj) ==  (1) ) then begin
            if (obj_is_locked(obj)) then
               sfall_func2("set_outline", obj, (2) ) ;
            else if ( ( inven_cmds(obj, (13) ,0) == 0) ) then
               sfall_func2("set_outline", obj, (4) ) ;
            else
               sfall_func2("set_outline", obj, (8) ) ;
         end else begin
            sfall_func2("set_outline", obj, (16) ) ;
         end
      end
   end


   foreach obj in list_as_array( (0) ) begin
      if (obj and obj != dude_obj) then begin
         isCorpse := (critter_state(obj) == 1);
         if (isCorpse and not  (get_proto_data(obj_pid(obj), PROTO_CR_FLAGS) bwand CFLG_NOSTEAL) ) then begin
            if (not  ( inven_cmds(obj, (13) ,0) == 0) ) then
               sfall_func2("set_outline", obj, (16) ) ;
            else
               sfall_func2("set_outline", obj, (4) ) ;
         end
      end
   end


   foreach obj in list_as_array( (2) ) begin
      if obj then begin
         sid :=  sfall_func2("get_object_data", obj, OBJ_DATA_SID) ;
         if (sid != -1 and not  ( sfall_func1("get_flags", obj) bwand FLAG_NOHIGHLIGHT) ) then begin
            if (obj_is_locked(obj) and not obj_is_open(obj)) then
               sfall_func2("set_outline", obj, (2) ) ;
            else
               sfall_func2("set_outline", obj, (64) ) ;
         end
      end
   end

end

procedure ShowStatusMsg(variable is_on) begin
   variable lang;
   lang := get_ini_string("fallout2.cfg|system|language");
   if (lang == "english") then begin
      if is_on then
         display_msg("Highlighting: ON");
      else
         display_msg("Highlighting: OFF");
   end else begin
      if is_on then
         display_msg("Подсветка: ВКЛ");
      else
         display_msg("Подсветка: ВЫКЛ");
   end
end

procedure KeyPressHandler begin
   variable pressed := get_sfall_arg;
   variable scanCode := get_sfall_arg;


   if (get_game_mode bwand ( (0x40)  bwor  (0x800) )) then return;
   if (get_game_mode != 0 and get_game_mode !=  (0x2) ) then return;


   if (scanCode == 58 and pressed) then begin
      persistent_active := not persistent_active;
      set_sfall_global("GL_PERM_HIGH", persistent_active);
      if persistent_active then begin
         call ApplyOutlines;
         call ShowStatusMsg(1);
      end else begin
         call ClearAllOutlines;
         call ShowStatusMsg(0);
      end
      return;
   end


   if (scanCode == 42 or scanCode == 54) then begin
      if (pressed and not shift_hold_active) then begin
         shift_hold_active := 1;
         call ApplyOutlines;
      end else if (not pressed and shift_hold_active) then begin
         shift_hold_active := 0;
         if (not persistent_active) then call ClearAllOutlines;
      end
   end
end

procedure GameModeChangeHandler begin

   if (persistent_active or shift_hold_active) then begin
      if (get_game_mode == 0 or get_game_mode ==  (0x2) ) then begin
         call ApplyOutlines;
      end
   end
end

procedure InventoryMoveHandler begin

   if ((persistent_active or shift_hold_active) and get_sfall_arg == 7) then begin
      sfall_func2("set_outline", get_sfall_arg, 0) ;
   end
end

procedure start begin
   if game_loaded then begin
      if (sfall_ver_major < 4) then return;
      persistent_active := get_sfall_global_int("GL_PERM_HIGH");

      register_hook_proc( (19) , KeyPressHandler);
      register_hook_proc( (31) , GameModeChangeHandler);
      register_hook_proc( (24) , InventoryMoveHandler);

      set_global_script_type(1);

      set_global_script_repeat(20);

      if persistent_active then call ApplyOutlines;
   end else begin

      if (persistent_active or shift_hold_active) then begin
         if (get_game_mode == 0 or get_game_mode ==  (0x2) ) then begin
            if (tile_num(dude_obj) != last_dude_tile) then begin
               last_dude_tile := tile_num(dude_obj);
               call ApplyOutlines;
            end
         end
      end
   end
end
