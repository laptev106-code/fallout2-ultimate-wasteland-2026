procedure beacon_rep begin
   variable rep := global_var( (0) );
   if has_trait( (0) , dude_obj,  (95) ) then rep := rep * 2;
   return rep;
end

procedure cult_rep begin
   variable rep := beacon_rep;
   if  has_trait( (0) , dude_obj, (39) )  then begin
      rep := abs(rep);
      if self_is_evil then rep := -rep;
   end
   return rep;
end

procedure perceived_rep begin
   variable rep := beacon_rep;
   if self_is_evil then rep := -rep;
   if  has_trait( (0) , dude_obj, (39) )  then rep := abs(rep);
   return rep;
end





