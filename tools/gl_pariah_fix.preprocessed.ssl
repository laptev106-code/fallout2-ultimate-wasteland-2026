procedure check_filesystem_override begin
   variable fs_override := get_ini_setting("ddraw.ini|Misc|UseFileSystemOverride");
   if fs_override != 1 then begin
      debug_msg( "gl_pariah_fix" + ": " + "UseFileSystemOverride is disabled, enabling" + "\n") ;
      sfall_func2("set_ini_setting", "ddraw.ini|Misc|UseFileSystemOverride", 1) ;
      float_msg(dude_obj,  "gl_pariah_fix"  + ": filesystem override was disabled, some features failed to load. The setting is corrected. EXIT AND RE-LAUNCH THE GAME now.",  (-2) );
      return false;
   end
   return true;
end


procedure create_and_use_itempid_on(variable target, variable itempid) begin
   variable item;
   item :=  create_object_sid(itempid,tile_num(target),elevation(target),-1) ;
   set_self(target);
   set_self(target);
   use_obj_on_obj(item, target);
   set_self(0);
end

procedure is_human(variable who) begin
   variable type;
   type :=  metarule( 51 , who) ;
   if type ==  0  or type ==  1  or type ==  2  then return true;
   return false;
end
