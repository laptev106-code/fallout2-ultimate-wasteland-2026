#line 15 "gl_laststand.ssl"
#line 1 "headers/aipacket.h"
#line 16 "gl_laststand.ssl"



variable enraged_list;
variable cfg_loaded;
variable cfg_kite_dist;
variable cfg_base_chance;
variable cfg_fearless_brutes;
variable cfg_float_msg;

procedure start;
procedure load_config;
procedure combatturn_handler;
procedure trigger_last_stand(variable cr, variable target);
procedure get_last_stand_phrase;
procedure get_closest_player_target(variable cr);
procedure has_usable_ranged_weapon(variable cr);
procedure is_civilian_or_coward(variable cr);

procedure load_config begin
   variable val;
   if (cfg_loaded) then return;


   val := get_ini_setting( "mods\\gl_laststand.ini"  + "|Settings|KitingDistance");
   if (val > 0) then cfg_kite_dist := val; else cfg_kite_dist := 12;


   val := get_ini_setting( "mods\\gl_laststand.ini"  + "|Settings|LastStandBaseChance");
   if (val >= 0) then cfg_base_chance := val; else cfg_base_chance := 8;


   val := get_ini_setting( "mods\\gl_laststand.ini"  + "|Settings|FearlessBrutes");
   if (val >= 0) then cfg_fearless_brutes := val; else cfg_fearless_brutes := 1;


   val := get_ini_setting( "mods\\gl_laststand.ini"  + "|Settings|FloatCombatMessages");
   if (val >= 0) then cfg_float_msg := val; else cfg_float_msg := 1;

   cfg_loaded := 1;
end

procedure start begin
   if game_loaded then begin
      if (sfall_ver_major < 4) then return;
      enraged_list := 0;
      cfg_loaded := 0;
      call load_config;
      register_hook_proc( (27) , combatturn_handler);
   end
end

procedure get_last_stand_phrase begin
   variable r;
   r := random(1, 12);
   if (r == 1) then return "Живым не сдамся! Я заберу тебя с собой!";
   if (r == 2) then return "К черту все! Сдохнем вместе!";
   if (r == 3) then return "Мне уже нечего терять! На куски разорву!";
   if (r == 4) then return "Думаешь, я побегу?! Умри, тварь!";
   if (r == 5) then return "Ты ляжешь в эту землю раньше меня!";
   if (r == 6) then return "Всех не перебьешь! Получай, ублюдок!";
   if (r == 7) then return "За Пустошь! Сдохни!";
   if (r == 8) then return "Я вырву твое сердце перед смертью!";
   if (r == 9) then return "Это мой последний бой, но ты пойдешь со мной!";
   if (r == 10) then return "А-а-а-а! Сдохни-и-и!";
   if (r == 11) then return "Ни шагу назад! Убью!";
   return "Давай, стреляй! Я все равно доберусь до твоей глотки!";
end

procedure get_closest_player_target(variable cr) begin
   variable best_target, min_dist, dist, p_list, who;
   best_target := dude_obj;
   min_dist := tile_distance_objs(cr, dude_obj);
   p_list :=  party_member_list(0) ;
   if (p_list != 0) then begin
      foreach (who in p_list) begin
         if (who != 0 and who != cr) then begin
            if (not  (critter_state(who) bwand (1) ) ) then begin
               dist := tile_distance_objs(cr, who);
               if (dist < min_dist) then begin
                  min_dist := dist;
                  best_target := who;
               end
            end
         end
      end
   end
   return best_target;
end

procedure has_usable_ranged_weapon(variable cr) begin
   variable item, range, mag_size, ammo_cnt;
   item := critter_inven_obj(cr,  (1) );
   if (item == 0 or obj_item_subtype(item) !=  (3) ) then begin
      item := critter_inven_obj(cr,  (2) );
   end
   if (item == 0 or obj_item_subtype(item) !=  (3) ) then return false;


   range := get_proto_data(obj_pid(item),  (52) );
   if (range <= 2) then return false;


   mag_size := get_proto_data(obj_pid(item),  (96) );
   if (mag_size > 0) then begin
      ammo_cnt := get_weapon_ammo_count(item);
      if (ammo_cnt <= 0) then return false;
   end

   return true;
end

procedure is_civilian_or_coward(variable cr) begin
   variable ai;
   ai := has_trait( (1) , cr,  (5) );
   if (ai ==  (2)  or ai ==  (3)  or ai ==  (4) ) then return true;
   if (ai ==  (14)  or ai ==  (15)  or ai ==  (25)  or ai ==  (33) ) then return true;
   if (ai ==  (35)  or ai ==  (45)  or ai ==  (49) ) then return true;
   if (ai ==  (179)  or ai ==  (180)  or ai ==  (184) ) then return true;
   return false;
end

procedure trigger_last_stand(variable cr, variable target) begin
   variable phrase;

   critter_set_flee_state(cr, 0);


   if (cfg_float_msg) then begin
      phrase := get_last_stand_phrase;
      float_msg(cr, phrase,  (2) );
   end


   attack_complex(target,0,1,0,0,30000,0,0) ;
end

procedure combatturn_handler begin
   variable event_type, cr, ktype, cur_hp, max_hp, hp_percent, dist, roll, chance, target, c_state;
   event_type := get_sfall_arg;
   cr := get_sfall_arg;


   if (event_type < 0) then begin
      if (enraged_list != 0) then begin
         free_array(enraged_list);
         enraged_list := 0;
      end
      return;
   end


   if (event_type != 1 or cr == 0 or cr == dude_obj) then return;


   if (party_member_obj(obj_pid(cr)) != 0) then return;


   call load_config;


   ktype := get_proto_data(obj_pid(cr),  (396) );


   target := get_closest_player_target(cr);


   if (cfg_fearless_brutes and (ktype == 3 or ktype == 10 or ktype == 13 or ktype == 16)) then begin
      if (critter_is_fleeing(cr)) then begin
         critter_set_flee_state(cr, 0);
         attack_complex(target,0,1,0,0,30000,0,0) ;
      end
      return;
   end


   if (ktype == 0 or ktype == 1 or ktype == 4) then begin

      if (get_critter_stat(cr,  (4) ) < 4) then return;


      if (is_civilian_or_coward(cr)) then return;


      c_state := critter_state(cr);
      if (c_state bwand  64 ) then return;
      if ((c_state bwand  16 ) and (c_state bwand  32 )) then return;

      cur_hp := get_critter_stat(cr,  (35) );
      max_hp := get_critter_stat(cr,  (7) );
      if (max_hp <= 0) then return;
      hp_percent := (cur_hp * 100) / max_hp;


      if (hp_percent <= 22 or cur_hp <= 15) then begin
         dist := tile_distance_objs(cr, target);




         if (dist >= cfg_kite_dist and critter_is_fleeing(cr)) then begin
            if (has_usable_ranged_weapon(cr)) then begin
               critter_set_flee_state(cr, 0);
               attack_complex(target,0,1,0,0,30000,0,0) ;
               return;
            end

         end



         if (enraged_list == 0) then enraged_list := create_array(0, 0);
         if (scan_array(enraged_list, cr) != -1) then return;


         chance := cfg_base_chance;
         if (get_critter_stat(cr,  (0) ) >= 7) then chance := chance + 2;
         if (get_critter_stat(cr,  (2) ) >= 7) then chance := chance + 2;

         roll := random(1, 100);
         if (roll <= chance) then begin
            call array_push(enraged_list, cr);
            call trigger_last_stand(cr, target);
         end
      end
   end
end
