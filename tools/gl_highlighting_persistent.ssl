/**
 * Fallout 2: Ultimate Wasteland Edition - Persistent Highlighting System
 * 
 * Features:
 * - Caps Lock (58): Persistent Toggle mode ("Включил и бегаешь")
 * - Shift (42): Temporary Hold mode (when persistent is OFF)
 * - NEVER drops after actions (survives inventory, dialog, barter, looting, combat, map transitions)
 * - Intelligent visual color hierarchy:
 *     - Glowing Green (8): Containers with loot
 *     - Bright Yellow (16): Ground items & lootable corpses
 *     - Red (2): Locked containers & locked doors
 *     - Purple (64): Interactive scenery (Bulletin boards, Terminals, Computers, Switches)
 *     - Gray (4): Empty/already-looted containers & empty corpses
 * - Bilingual notifications (RU / EN)
 */

#pragma sce

#include "main.h"

#define CRITTER_IS_DEAD             (1)
#define REPEAT_TICKS                (8)

#define COLOR_ITEMS                 (16) // Bright yellow
#define COLOR_CORPSES               (16) // Bright yellow
#define COLOR_CORPSE_EMPTY          (4)  // Subtle gray for empty corpses
#define COLOR_CONTAINERS            (8)  // Glowing green for loot
#define COLOR_CONTAINER_EMPTY       (4)  // Subtle gray for empty looted containers
#define COLOR_LOCKED                (2)  // Red for locked doors/containers
#define COLOR_INTERACTIVE_SCENERY   (64) // Purple for Bulletin Boards, Terminals, Computers

#define NO_HIGHLIGHT(obj)           (get_flags(obj) bwand FLAG_NOHIGHLIGHT)
#define NO_STEAL(obj)               (get_proto_data(obj_pid(obj), PROTO_CR_FLAGS) bwand CFLG_NOSTEAL)
#define IS_EMPTY(obj)               (inven_ptr(obj, 0) == 0)

variable persistent_active := 0;
variable shift_hold_active := 0;
variable lang;

procedure DudeCanSee(variable obj) begin
   variable block := obj_blocking_line(dude_obj, tile_num(obj), BLOCKING_TYPE_SHOOT);
   return (not block or block == obj or tile_num(block) == tile_num(obj));
end

procedure GetItemColor(variable obj) begin
   if (obj_item_subtype(obj) == item_type_container) then begin
      if (obj_is_locked(obj)) then return COLOR_LOCKED;
      if (IS_EMPTY(obj)) then return COLOR_CONTAINER_EMPTY;
      return COLOR_CONTAINERS;
   end
   return COLOR_ITEMS;
end

procedure ApplyHighlight(variable enable) begin
   variable obj, isCorpse, col, sid;

   // 1. Ground items & Containers
   foreach obj in list_as_array(LIST_GROUNDITEMS) begin
      if obj and obj != outlined_object then begin
         if enable then begin
            if (not NO_HIGHLIGHT(obj)) then begin
               col := GetItemColor(obj);
               set_outline(obj, col);
            end
         end else begin
            set_outline(obj, 0);
         end
      end
   end

   // 2. Dead Bodies (Corpses)
   foreach obj in list_as_array(LIST_CRITTERS) begin
      if obj and obj != dude_obj then begin
         isCorpse := (critter_state(obj) == CRITTER_IS_DEAD);
         if isCorpse and not NO_STEAL(obj) then begin
            if enable then begin
               if (not IS_EMPTY(obj)) then begin
                  set_outline(obj, COLOR_CORPSES);
               end else begin
                  set_outline(obj, COLOR_CORPSE_EMPTY);
               end
            end else begin
               set_outline(obj, 0);
            end
         end
      end
   end

   // 3. Scenery: Interactive Props (Bulletin Boards, Terminals, Computers, Locked Doors)
   foreach obj in list_as_array(LIST_SCENERY) begin
      if obj then begin
         if enable then begin
            sid := get_object_data(obj, OBJ_DATA_SID);
            if (sid != -1 and not NO_HIGHLIGHT(obj)) then begin
               if (obj_is_locked(obj) and not obj_is_open(obj)) then begin
                  set_outline(obj, COLOR_LOCKED);
               end else begin
                  set_outline(obj, COLOR_INTERACTIVE_SCENERY);
               end
            end else begin
               set_outline(obj, 0);
            end
         end else begin
            set_outline(obj, 0);
         end
      end
   end

   tile_refresh_display;
end

procedure KeyPressHandler begin
   variable pressed  := get_sfall_arg;
   variable scanCode := get_sfall_arg;

   // 1. Caps Lock (58) - Toggle Persistent Mode
   if (scanCode == 58 and pressed) then begin
      if not (get_game_mode bwand bwnot(COMBAT bwor PCOMBAT)) then begin
         persistent_active := not persistent_active;
         set_sfall_global("GL_PERM_HIGH", persistent_active);
         lang := get_ini_string("fallout2.cfg|system|language");

         if persistent_active then begin
            set_global_script_repeat(REPEAT_TICKS);
            call ApplyHighlight(true);
            if (lang == "english") then display_msg("Permanent highlight: ON");
            else display_msg("Постоянная подсветка: ВКЛ");
         end else begin
            set_global_script_repeat(0);
            shift_hold_active := 0;
            call ApplyHighlight(false);
            if (lang == "english") then display_msg("Permanent highlight: OFF");
            else display_msg("Постоянная подсветка: ВЫКЛ");
         end
      end
      return;
   end

   // 2. Left Shift (42) - Temporary Hold Mode (only if persistent is OFF)
   if (scanCode == 42 and not persistent_active) then begin
      if not (get_game_mode bwand bwnot(COMBAT bwor PCOMBAT)) then begin
         if pressed then begin
            shift_hold_active := 1;
            set_global_script_repeat(REPEAT_TICKS);
            call ApplyHighlight(true);
         end else begin
            shift_hold_active := 0;
            set_global_script_repeat(0);
            call ApplyHighlight(false);
         end
      end
      return;
   end
end

procedure GameModeChangeHandler begin
   // When returning from menus/dialogs back to game map, restore highlight if active
   if (persistent_active or shift_hold_active) then begin
      if not (get_game_mode bwand bwnot(COMBAT bwor PCOMBAT)) then begin
         set_global_script_repeat(REPEAT_TICKS);
         call ApplyHighlight(true);
      end
   end
end

procedure InventoryMoveHandler begin
   // Clear outline from object when it is moved into inventory
   if ((persistent_active or shift_hold_active) and get_sfall_arg == 7) then begin
      set_outline(get_sfall_arg, 0);
   end
end

procedure start begin
   if game_loaded then begin
      if (sfall_ver_major < 4) then return;

      // Restore saved persistent state if player had it active
      persistent_active := get_sfall_global_int("GL_PERM_HIGH");

      register_hook_proc(HOOK_KEYPRESS, KeyPressHandler);
      register_hook_proc(HOOK_GAMEMODECHANGE, GameModeChangeHandler);
      register_hook_proc(HOOK_INVENTORYMOVE, InventoryMoveHandler);

      set_global_script_type(1);

      if persistent_active then begin
         set_global_script_repeat(REPEAT_TICKS);
         call ApplyHighlight(true);
      end
   end else begin
      // Periodic refresh tick (runs every REPEAT_TICKS while active)
      if (persistent_active or shift_hold_active) then begin
         if not (get_game_mode bwand bwnot(COMBAT bwor PCOMBAT)) then begin
            call ApplyHighlight(true);
         end
      end
   end
end
